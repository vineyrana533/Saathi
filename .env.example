# Copy to .env.local for local overrides. Every variable has a safe local default in
# src/platform/env.ts, so local development works without this file.
# NEVER commit real values. Staging and production values live in Vercel project settings.

# local | test | staging | production
APP_ENV=local
SITE_URL=http://localhost:3000

# App role: not the table owner, no BYPASSRLS. Row-level security applies to every query.
# Supabase: use the transaction pooler URL (port 6543) for this one.
DATABASE_URL=postgres://saathi_app:saathi_app_local@localhost:54329/saathi
# Owner role, used only by migrations (pnpm db:migrate). Supabase: the direct connection URL.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:54329/saathi
DATABASE_POOL_MAX=10

# Secrets (required explicitly in production). Generate with: openssl rand -base64 32
OTP_PEPPER=
DOCUMENT_ENCRYPTION_KEY=
SANDBOX_WEBHOOK_SECRET=
CRON_SECRET=

# Adapters. Only sandbox/dev implementations exist until vendors are approved (docs/decisions.md).
PAYMENTS_MODE=sandbox
# Must stay false until gateway category approval is recorded (decisions.md V-01).
PAYMENTS_LIVE_APPROVED=false
SMS_PROVIDER=dev-log
# Fixed OTP 123456 for these numbers only, never in production.
DEV_TEST_PHONES=+919000000001,+919000000002,+919000000003,+919000000004,+919000000005
DOCUMENT_STORE=local-encrypted
LOCAL_DOCUMENT_DIR=.local/documents

LOG_LEVEL=info

# Staging only: puts the whole site behind one shared password (HTTP Basic auth).
# Leave empty locally and in production.
STAGING_ACCESS_PASSWORD=

# Supabase Storage for worker documents (server-only; never prefix the key with NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DOCUMENTS_BUCKET=worker-documents
