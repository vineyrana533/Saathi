{
  "name": "saathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Saathi: multi-category marketplace for hiring verified people in India",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "jobs:run": "tsx scripts/run-jobs.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
